{
  "name": "Lecturer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ],
      "default": "other"
    },
    "bio": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}